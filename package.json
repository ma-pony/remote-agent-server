{
  "name": "remote-agent-server",
  "description": "Self-hosted ACP execution gateway for running coding agents through HTTP, SSE, and signed webhooks.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ma-pony/remote-agent-server.git"
  },
  "homepage": "https://github.com/ma-pony/remote-agent-server#readme",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "init": "node --import tsx src/setup.ts",
    "doctor": "node --import tsx src/setup.ts --check",
    "dev": "concurrently --kill-others --names api,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "NODE_ENV=development tsx watch src/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "prestart": "pnpm build",
    "start": "NODE_ENV=production node dist/server/main.js",
    "smoke:integrations": "tsx scripts/smoke-integrations.ts",
    "smoke:providers": "tsx scripts/smoke-providers.ts",
    "test": "vitest run",
    "test:mcp-process": "REMOTE_AGENT_MCP_PROCESS_TEST=1 REMOTE_AGENT_ACPX_PROCESS_TEST=1 vitest run test/mcp-tool-filter.test.ts test/acpx-process-cleanup.test.ts test/project-environments.test.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc --ignoreConfig --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --types node scripts/smoke-providers.ts scripts/smoke-integrations.ts"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.1.14",
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "acpx": "0.16.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.3",
    "fflate": "^0.8.3",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "jsdom": "^27.4.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
