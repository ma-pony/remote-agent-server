HOST=0.0.0.0
PORT=3000
API_TOKEN=replace-with-a-long-random-token
DATA_DIR=/srv/remote-agent/data
DATABASE_PATH=/srv/remote-agent/data/remote-agent.sqlite3
WORKSPACE_TEMPLATE=/srv/remote-agent/template/workspace
PROJECT_ENVIRONMENTS_ROOT=/srv/remote-agent/environments
SESSIONS_ROOT=/srv/remote-agent/sessions
MAX_CONCURRENT_RUNS=4
# Optional overrides; defaults are 3 hours and 30 minutes.
PROJECT_ENVIRONMENT_CHECK_INTERVAL_HOURS=3
PROJECT_PREPARE_TIMEOUT_MINUTES=30
# Optional real-provider smoke settings. API_TOKEN above is also used by the script.
SMOKE_BASE_URL=http://127.0.0.1:3000
SMOKE_POLL_INTERVAL_MS=1000
SMOKE_RUN_TIMEOUT_MS=300000
# Optional external Integration smoke settings. Copy API_TOKEN to SMOKE_API_TOKEN explicitly.
# Run this smoke on the same host as the service so its local Webhook receiver is reachable.
SMOKE_API_TOKEN=replace-with-the-management-api-token
SMOKE_AGENT_ID=replace-with-an-enabled-ready-agent-id
SMOKE_TASK_TIMEOUT_MS=300000
SMOKE_REQUEST_TIMEOUT_MS=30000
# Needed only when the service uses a local headed X display.
DISPLAY=:0
XAUTHORITY=/home/remote-agent/.Xauthority
