# Recommended: run `pnpm run init` to generate a private .env and a random token.
# The server loads .env automatically; inherited environment variables win.
# Values are literal: use absolute paths, not $HOME, ~, or shell substitutions.
HOST=127.0.0.1
PORT=3000
API_TOKEN=replace-with-a-long-random-token
DATA_DIR=/srv/remote-agent/data
DATABASE_PATH=/srv/remote-agent/data/remote-agent.sqlite3
PROJECT_ENVIRONMENTS_ROOT=/srv/remote-agent/environments
SESSIONS_ROOT=/srv/remote-agent/sessions
MAX_CONCURRENT_RUNS=4
MAX_CONCURRENT_WEBHOOK_DELIVERIES=4
MAX_CONCURRENT_ENVIRONMENT_BUILDS=1
# Optional overrides; defaults are 3 hours, 30 minutes, and 7 days.
PROJECT_ENVIRONMENT_CHECK_INTERVAL_HOURS=3
PROJECT_PREPARE_TIMEOUT_MINUTES=30
# Large storage is checked at startup and every 10 minutes. Set to 0 to disable automatic cleanup.
SESSION_RETENTION_HOURS=168
# Optional: only set these when using a real Linux desktop/X display.
# DISPLAY=:0
# XAUTHORITY=/home/remote-agent/.Xauthority
# Real Provider/integration smoke settings are described in docs/deployment.md.
